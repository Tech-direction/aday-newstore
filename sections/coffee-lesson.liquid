{% comment %}
  coffee lesson　A day in the coffeeのコーヒー講座 セクション
{% endcomment %}
{{ 'section-coffee-lesson.css' | asset_url | stylesheet_tag }}
<section class="section-coffee-lesson">
  <div class="page-width">
    <h2
      class="heading type-sub_heading{% if section.settings.heading_size != 'default' %} size-{{ section.settings.heading_size }} {% endif %}"
      data-sub_heading="{{ section.settings.section_sub_heading }}"
    >
      {{ section.settings.section_heading }}
    </h2>
    <div class="coffee-lesson-content">
      <div class="coffee-lesson-image">
        <img
          src="{{ 'section-coffee-lesson-image01.webp' | asset_url }}"
          alt="A day in the coffeeのコーヒー講座"
          width=""
          height=""
        >
      </div>
      <div class="coffee-lesson-links">
        <a href="/pages/coffee-lesson" class="coffee-lesson-link">
          小さく始める<br>
          <span>焙煎とエスプレッソ・ラテ講座</span>
        </a>
        <a href="/pages/coffee-lesson" class="coffee-lesson-link">
          おうちコーヒーが好きになる<br>
          <span>ドリップ講座</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "コーヒー講座",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "セクション見出し",
      "default": "A day in the coffeeのコーヒー講座"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "default", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "m", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "l", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "xl", "label": "最大" }
      ],
      "default": "l",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "section_sub_heading",
      "label": "サブ見出し"
    }
  ],
  "presets": [{ "name": "コーヒー講座" }]
}
{% endschema %}
