{% comment %}
  私たちのこだわり セクション
{% endcomment %}
{{ 'section-featured-concept.css' | asset_url | stylesheet_tag }}
<section class="section-featured-concept">
  <div class="page-width featured-concept-content">
    <div class="featured-concept-image">
      <img
        src="{{ 'section-featured-concept-image01.webp' | asset_url }}"
        alt="私たちのこだわり"
        width=""
        height=""
      >
    </div>
    <div class="featured-concept-text">
      <h2
        class="heading type-sub_heading{% if section.settings.heading_size != 'default' %} size-{{ section.settings.heading_size }} {% endif %}"
        data-sub_heading="{{ section.settings.section_sub_heading }}"
      >
        {{ section.settings.section_heading }}
      </h2>
      <div class="featured-concept-description">
        <p>
          コーヒーは、毎日の中でいちばん身近な“贅沢”かもしれません。<br>
          だからこそ、わたしたちはその一杯が、ちゃんと美味しくあってほしいと思うのです。<br>
        </p>
        <p>
          焙煎も、抽出も、すこしの工夫でぐんと変わる。酸っぱいだけじゃない、苦いだけでもない、香りと味のバランスを整える。<br>
          そんな「香りが良くて、ちょうどいい美味しさ」を、まっすぐに届けたくて、今日も豆に火を入れています。<br>
        </p>
        <p>いつものコーヒー時間がもっと好きになる。そんなコーヒーを、これからもお届けしていきます。</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "私たちのこだわり",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "セクション見出し",
      "default": "私たちのこだわり"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "default", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "m", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "l", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "xl", "label": "最大" }
      ],
      "default": "l",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "section_sub_heading",
      "label": "サブ見出し"
    }
  ],
  "presets": [{ "name": "私たちのこだわり" }]
}
{% endschema %}
