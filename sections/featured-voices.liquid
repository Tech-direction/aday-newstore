{% comment %}
  こんな声をいただいています セクション
{% endcomment %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{{ 'section-featured-voices.css' | asset_url | stylesheet_tag }}

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="{{ 'section-featured-voices.js' | asset_url }}" defer></script>

<section class="section-featured-voices">
  <div class="page-width">
    <h2
      class="heading type-sub_heading{% if section.settings.heading_size != 'default' %} size-{{ section.settings.heading_size }} {% endif %}"
      data-sub_heading="{{ section.settings.section_sub_heading }}"
    >
      {{ section.settings.section_heading }}
    </h2>
    <div class="featured-voices-content">
      {% if section.blocks.size > 0 %}
        <div class="featured-voices-swiper swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide featured-voices-slide" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <p class="featured-voices-title">{{ block.settings.title | escape }}</p>
                {% endif %}
                {% if block.settings.text %}
                  <p class="featured-voices-text">
                    {{ block.settings.text | escape | newline_to_br }}
                  </p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
    <div class="featured-voices-button">
      <a href="#" class="button type-primary">詳しく見る</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "こんな声をいただいています",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "セクション見出し",
      "default": "こんな声をいただいています"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "default", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "m", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "l", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "xl", "label": "最大" }
      ],
      "default": "l",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "section_sub_heading",
      "label": "サブ見出し"
    }
  ],
  "blocks": [
    {
      "type": "voice",
      "name": "お客様の声",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "タイトル"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "お客様の声（テキスト）"
        }
      ]
    }
  ],
  "presets": [{ "name": "こんな声をいただいています" }]
}
{% endschema %}
