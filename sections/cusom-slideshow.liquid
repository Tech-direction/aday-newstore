<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{{ 'section-custom-slideshow.css' | asset_url | stylesheet_tag }}

<div class="custom-slideshow {{ section.settings.class_name }}">
  {% if section.blocks.size > 0 %}
    <div class="custom-slideshow__container swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div
            class="custom-slideshow__slide swiper-slide"
            style="background-image: url({{ block.settings.image | image_url: width: 1000 }});"
            {{ block.shopify_attributes }}
          >
            <div
              class="custom-slideshow__content"
              {%- if block.settings.background_color != blank -%}
                {%- assign alpha_value = block.settings.background_opacity | times: 0.01 -%}
                style="background-color: {{ block.settings.background_color | color_modify: 'alpha', alpha_value }};"
              {%- endif -%}
            >
              {% if block.settings.subheading != blank %}
                <p class="custom-slideshow__subheading">{{ block.settings.subheading | escape }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <h2 class="custom-slideshow__title">{{ block.settings.title | escape }}</h2>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="custom-slideshow__description">{{ block.settings.description | escape }}</p>
              {% endif %}
              {%- if block.settings.subscription_feature != blank -%}
                <ul class="grid grid--3-col-desktop grid--3-col-tablet grid--gap-s subscription-feature-list">
                  {%- if settings.grid_item_1_heading != blank -%}
                    <li class="grid__item feature__item">
                      <figure>
                        {{
                          settings.grid_item_1_img
                          | image_url: width: 600
                          | image_tag:
                            class: 'subscription-feature-media-1',
                            widths: widths,
                            height: logo_height,
                            width: settings.logo_width,
                            alt: logo_alt,
                            sizes: sizes,
                            preload: true
                        }}
                      </figure>
                      <div class="heading">{{ settings.grid_item_1_heading }}</div>
                    </li>
                  {% endif %}
                  {%- if settings.grid_item_2_heading != blank -%}
                    <li class="grid__item feature__item {% if settings.grid_item_sale == true %}type-sale{% endif %}">
                      {% if settings.grid_item_sale != true %}
                        <figure>
                          {{
                            settings.grid_item_2_img
                            | image_url: width: 600
                            | image_tag:
                              class: 'subscription-feature-media-2',
                              widths: widths,
                              height: logo_height,
                              width: settings.logo_width,
                              alt: logo_alt,
                              sizes: sizes,
                              preload: true
                          }}
                        </figure>
                        <div class="heading">{{ settings.grid_item_2_heading }}</div>
                      {% else %}
                        <figure>
                          {{
                            settings.grid_item_2_img_sale
                            | image_url: width: 600
                            | image_tag:
                              class: 'subscription-feature-media-2',
                              widths: widths,
                              height: logo_height,
                              width: settings.logo_width,
                              alt: logo_alt,
                              sizes: sizes,
                              preload: true
                          }}
                        </figure>
                        <div class="heading">{{ settings.grid_item_2_heading_sale }}</div>
                      {% endif %}
                    </li>
                  {% endif %}
                  {%- if settings.grid_item_3_heading != blank -%}
                    <li class="grid__item feature__item">
                      <figure>
                        {{
                          settings.grid_item_3_img
                          | image_url: width: 600
                          | image_tag:
                            class: 'subscription-feature-media-3',
                            widths: widths,
                            height: logo_height,
                            width: settings.logo_width,
                            alt: logo_alt,
                            sizes: sizes,
                            preload: true
                        }}
                      </figure>
                      <div class="heading">{{ settings.grid_item_3_heading }}</div>
                    </li>
                  {% endif %}
                </ul>
              {%- endif -%}
              {% if block.settings.is_link == true %}
                <a href="{{ block.settings.link }}" class="button type-primary custom-slideshow__button">
                  {{ block.settings.button_text | escape }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const slider = document.querySelector('.custom-slideshow__container');
    if (!slider) return;

    const swiper = new Swiper(slider, {
      loop: true,
      speed: 1000,
      autoplay: {
        delay: 8000,
        disableOnInteraction: false,
      },
    });
  });
</script>

{% schema %}
{
  "name": "Custom Slideshow",
  "tag": "section",
  "class": "section section-custom-slideshow",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "class_name",
      "label": "クラス名"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "スライド",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "小見出し"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "見出し"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "説明"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "背景色",
          "default": "#ffffff",
          "info": "テキストボックスの背景色を設定します"
        },
        {
          "type": "range",
          "id": "background_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "背景色の透明度",
          "default": 85,
          "info": "背景色の透明度を設定します（0% = 完全に透明、100% = 完全不透明）"
        },
        {
          "type": "checkbox",
          "id": "subscription_feature",
          "label": "定期購買の特徴を表示する",
          "default": false,
          "info": "各項目は左メニュー「テーマ設定」>「定期購買の特徴」で編集ができます。"
        },
        {
          "type": "inline_richtext",
          "id": "button_text",
          "label": "リンクテキスト"
        },
        {
          "type": "url",
          "id": "link",
          "label": "リンク"
        },
        {
          "type": "checkbox",
          "id": "is_link",
          "label": "リンクを表示する",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "カスタムスライドショー",
      "blocks": []
    }
  ]
}
{% endschema %}
