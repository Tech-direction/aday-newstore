{% stylesheet %}
  .custom-blocks-group {
    display: flex;
    row-gap: var(--custom-margin);
    flex-wrap: wrap;
  }
{% endstylesheet %}

<div class="custom-blocks-group {{ block.settings.group_id }}" data-group-label="{{ block.settings.group_name }}" data-group-id="{{ block.settings.group_id }}">
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Group",
  "class": "group__item",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "group_name",
      "label": "グループ名",
      "info": "※タブコンテンツの場合は必須。タブのラベルになります"
    },
    {
      "type": "text",
      "id": "group_id",
      "label": "グループID",
      "info": "※グループの追加クラス。タブコンテンツの場合は必須。タブの同期用のIDになります"
    },
  ],
  "presets": [
    {
      "name": "Group"
    }
  ]
}
{% endschema %}