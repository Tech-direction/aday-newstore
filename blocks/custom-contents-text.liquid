<div class="align-{{ block.settings.alignment }} {{ block.settings.item_class }}">
  {{ block.settings.text }}
</div>

{% schema %}
{
  "name": "テキスト",
  "class": "blocks__item blocks__item-text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "配置"
    },
    {
      "type": "text",
      "id": "item_class",
      "label": "要素の追加クラス"
    },
  ],
  "presets": [
    { "name": "テキスト" },
  ]
}
{% endschema %}